# Use an ISO-8601 value with a timezone only when the recording start is known.
# VIDEO_START_TIME=2026-11-18T10:30:00+05:30
VIDEO_PLAYBACK_SPEED=1.0
LOG_LEVEL=INFO

YOLO_WEIGHTS=data/models/yolov8n.pt
YOLO_DEVICE=cpu
YOLO_IMAGE_SIZE=640
YOLO_CONFIDENCE=0.1
YOLO_IOU=0.7
YOLO_AGNOSTIC_NMS=false
YOLO_INFERENCE_INTERVAL=1
BYTETRACK_CONFIG=config/bytetrack.yaml
TRACK_HISTORY_SIZE=30
TRACK_HISTORY_MAX_MISSES=30

# Coordinates are in source pixels
# TRIPWIRE_POINTS=100,360,1180,360
TRIPWIRE_MODE=AUTO
TRIPWIRE_ENTRY_SIDE=positive
TRIPWIRE_DEADBAND=4
TRIPWIRE_MIN_MOVEMENT=12
TRIPWIRE_CONFIRMATION=2
TRIPWIRE_COOLDOWN=1
TRIPWIRE_MAX_GAP=1

ANPR_OUTBOX=data/outbox
ANPR_EVIDENCE=data/snapshots
OCR_PRE=5
OCR_POST=5
OCR_MAX_CANDIDATES=6
OCR_QUEUE_SIZE=8
OCR_MIN_CONFIDENCE=0.65
OCR_AGREEMENT=2
OCR_TIMEOUT=30
OCR_RETRIES=1

SITE_TIMEZONE=Asia/Kolkata
ANPR_API_URL=http://127.0.0.1:8010
ANPR_LIVE=data/live
ANPR_IMAGE_RETENTION_DAYS=30
RTSP_TIMEOUT_MS=4000
RTSP_BUFFER=4
# Set locally with generated secrets and a user created with backend.admin.
# POSTGRES_PASSWORD=
# API_SIGNING_KEY=
# DATABASE_URL=postgresql+psycopg://anpr:...@127.0.0.1:55432/anpr
# ANPR_INGEST_USERNAME=
# ANPR_INGEST_PASSWORD=
# CAMERA_SOURCE_SAMPLE=data/videos/anpr-demo-video.mp4
